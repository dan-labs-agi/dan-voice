VC_ENV=development
VC_LOG_LEVEL=INFO

# Ephemeral dev secret auto-generated (and logged as a warning) if unset —
# set this explicitly before Phase 3's public tunnel goes live.
# VC_JWT_SECRET=
VC_JWT_ALGORITHM=HS256
VC_JWT_LEEWAY_SECONDS=10

VC_SESSION_TTL_SECONDS=43200
VC_PIN_TTL_SECONDS=300
VC_PIN_RATE_LIMIT=10/minute

# Web client origins allowed to call this backend cross-origin (comma-separated,
# or a JSON array). Must include the web client's real public hostname once the
# second tunnel ingress rule is set up, or the browser will reject responses.
VC_CORS_ORIGINS=http://localhost:3000,https://<web-subdomain>.<yourdomain.com>

# --- opencode connection (read by both the backend and the CLI) ---
VC_OPENCODE_HOST=127.0.0.1
VC_OPENCODE_PORT=4096

# --- CLI / tunnel orchestration (see cli.py) ---
VC_BACKEND_HOST=127.0.0.1
VC_BACKEND_PORT=8000
VC_CLOUDFLARED_METRICS_PORT=20241
VC_PROCESS_READY_TIMEOUT_SECONDS=20
VC_PUBLIC_HEALTH_RETRY_SECONDS=180
VC_CLOUDFLARED_CONFIG_PATH=cloudflared/config.yml
VC_TUNNEL_HOSTNAME=<subdomain>.<yourdomain.com>
VC_WEB_HOSTNAME=<web-subdomain>.<yourdomain.com>

# Which opencode server binary the CLI spawns: "opencode" (stock, on PATH)
# or "dani-cli" (the dani-cli project's branded fork, resolved from
# ~/.dani/bin or DANI_OPENCODE_BIN). Overridable per-run via `--ai-tool`.
VC_AI_TOOL=opencode
VC_OPENCODE_BINARY=opencode

# --- STT (speech-to-text): local, via pywhispercpp/whisper.cpp ---
# Model auto-downloads on first use and is cached locally afterward.
VC_WHISPER_MODEL=base.en

# --- TTS (text-to-speech): "pyttsx3" (local/offline) or "deepgram" (cloud) ---
VC_TTS_ENGINE=pyttsx3

# pyttsx3 voice ID (a SAPI5 registry token on Windows, e.g. one of the IDs
# printed by `engine.getProperty('voices')`) — leave unset to use whatever
# pyttsx3.init() picks as the machine's own default voice.
# VC_PYTTSX3_VOICE_ID=

# Only needed if VC_TTS_ENGINE=deepgram.
# VC_DEEPGRAM_API_KEY=
VC_DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# --- Groq: called directly by our own backend via httpx, NOT through
# opencode's own provider/auth store — used only for fast, cheap one-
# sentence tool-call summaries (see groq_summarizer.py), never for
# opencode's actual reasoning/response generation. ---
# VC_GROQ_API_KEY=
VC_GROQ_SUMMARY_MODEL=llama-3.1-8b-instant
